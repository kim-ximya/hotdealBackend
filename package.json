{
  "name": "hotdeal-backend",
  "version": "2.0.0",
  "private": true,
  "description": "Tauri와 Rust 기반 아카라이브 핫딜 수집 앱",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "desktop": "node build/prepare-tauri.cjs && tauri dev --no-dev-server -- --locked",
    "start": "node build/prepare-tauri.cjs && cargo run --locked --manifest-path src-tauri/Cargo.toml --no-default-features --bin hotdeal-server",
    "test": "node --test test/*.test.js && cargo test --locked --manifest-path src-tauri/Cargo.toml --no-default-features",
    "dist:win": "node build/tauri-dist.cjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "selenium-webdriver": "4.51.0"
  }
}
