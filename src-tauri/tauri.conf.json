{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "핫딜 수집 관리자",
  "version": "2.0.0",
  "identifier": "com.hotdealcollector.tauri",
  "build": { "frontendDist": "../.local/tauri-frontend" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "핫딜 수집 관리자", "width": 1160, "height": 960,
        "minWidth": 940, "minHeight": 740, "visible": false, "backgroundColor": "#0c111b" }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; media-src 'self'; connect-src ipc: http://ipc.localhost; base-uri 'none'; form-action 'none'; frame-src 'none'"
    }
  },
  "plugins": { "updater": { "pubkey": "", "endpoints": [] } },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["../desktop/assets/hotdeal.ico"],
    "resources": {
      "resources/selenium-manager.exe": "selenium-manager.exe",
      "resources/SELENIUM-NOTICES.txt": "SELENIUM-NOTICES.txt"
    },
    "windows": { "nsis": { "installMode": "currentUser", "installerHooks": "installer-hooks.nsh" } }
  }
}
