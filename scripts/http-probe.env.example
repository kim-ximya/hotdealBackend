# Copy to the project root as .env.http-probe and edit locally.
# Run: node --env-file=.env.http-probe scripts/http-probe.js
# Copy VALUES from DevTools > Network > hotdeal document > Request Headers.
# Do not include the "Cookie:" / "User-Agent:" prefixes or Set-Cookie attributes.
# Do not commit or share the filled-in file.
ARCA_COOKIE=''
ARCA_USER_AGENT=''

# Optional: use only if the actual request includes an Authorization header.
ARCA_AUTHORIZATION=''
