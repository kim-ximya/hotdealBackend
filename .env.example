# The server loads .env automatically. External environment variables take precedence.
PORT=38471
DATA_DIR=.local/selenium-server
MAX_ARTICLES=10000
SELENIUM_WAIT_SECONDS=120

# Default: 180 seconds (3 minutes). If unset, persisted API settings are used.
# An explicit value here overrides the persisted interval after a restart.
# CRAWL_INTERVAL_SECONDS=180

# Optional browser executable. Otherwise Selenium Manager discovers installed Chrome.
# SELENIUM_CHROME_BINARY=C:/Program Files/Google/Chrome/Application/chrome.exe

# CLI only: override the saved browser-settings.json User-Agent. Empty means Chrome default.
# Desktop UI uses its saved User-Agent instead of this environment variable.
# SELENIUM_USER_AGENT=

# Exact frontend origins for CORS, separated by commas. No wildcard.
# FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
